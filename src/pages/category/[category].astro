---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/layout/Navbar';
import Footer from '../../components/layout/Footer';
import { CATEGORIES, getToolsByCategory } from '../../data/tools';
import { ToolIcon, getCategoryTheme } from '../../components/common/IconHelper';
import { getSiteUrl } from '../../utils/site';
import { buildCategorySchema } from '../../utils/schema';

export async function getStaticPaths() {
  return CATEGORIES.map(cat => ({
    params: { category: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const tools = getToolsByCategory(category.slug);
const theme = getCategoryTheme(category.slug);
const origin = (Astro.site ? Astro.site.origin : getSiteUrl()).replace(/\/$/, '');
const schema = buildCategorySchema(origin, category, tools);
---
<BaseLayout
  title={`${category.name} - Free Online Tools | CalculateAnything`}
  description={`Browse ${category.count} free ${category.name.toLowerCase()} online. No sign-up required.`}
  canonical={`/category/${category.slug}/`}
  schema={schema}
>
  <Navbar client:load />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 min-h-screen">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6 text-xs text-gray-500 dark:text-gray-400">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/tools/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Categories</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-gray-800 dark:text-gray-200 font-semibold">{category.name}</li>
      </ol>
    </nav>

    <!-- Category Header Card -->
    <div class="mb-10 p-6 sm:p-8 rounded-3xl bg-white dark:bg-gray-850 border border-gray-200/90 dark:border-gray-800 flex flex-col sm:flex-row items-start sm:items-center gap-6 shadow-sm">
      <div class={`w-16 h-16 rounded-2xl flex items-center justify-center shrink-0 shadow-sm ${theme.bg} ${theme.text}`}>
        <ToolIcon name={category.icon} className="w-8 h-8" />
      </div>
      <div>
        <div class="flex items-center gap-2.5 flex-wrap mb-1.5">
          <h1 class="text-3xl font-extrabold text-gray-900 dark:text-gray-100 tracking-tight">
            {category.name}
          </h1>
          <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${theme.badgeBg}`}>
            {tools.length} Tools
          </span>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-400 max-w-2xl">
          Free, accurate, and instant online tools and calculators for {category.name.toLowerCase()}. Run directly in your browser with zero configuration.
        </p>
      </div>
    </div>

    <!-- Tools Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {tools.map(tool => (
        <a
          href={`/tools/${tool.slug}/`}
          class="group flex flex-col justify-between p-5 rounded-2xl border border-gray-200/90 dark:border-gray-800 bg-white dark:bg-gray-850 hover:bg-gradient-to-b hover:from-white hover:to-blue-50/20 dark:hover:bg-gray-800 hover:border-blue-400 dark:hover:border-blue-500 hover:shadow-lg hover:shadow-blue-500/5 hover:-translate-y-0.5 transition-all duration-200"
        >
          <div>
            <div class="flex items-center justify-between mb-3.5">
              <div class={`w-10 h-10 rounded-xl flex items-center justify-center transition-transform group-hover:scale-110 duration-200 ${theme.bg} ${theme.text}`}>
                <ToolIcon name={tool.icon} className="w-5 h-5" />
              </div>
              <span class="text-xs font-semibold text-blue-600 dark:text-blue-400 opacity-0 group-hover:opacity-100 transition-opacity">
                Open &rarr;
              </span>
            </div>
            <h2 class="font-bold text-base mb-1.5 text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {tool.name}
            </h2>
            <p class="text-xs text-gray-500 dark:text-gray-400 line-clamp-2 leading-relaxed">
              {tool.description}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-800/80 flex items-center justify-between text-xs text-gray-400 dark:text-gray-500">
            <span>Free utility</span>
            <span class="text-blue-600 dark:text-blue-400 font-medium">Use tool</span>
          </div>
        </a>
      ))}
    </div>
  </main>

  <Footer client:load />
</BaseLayout>
