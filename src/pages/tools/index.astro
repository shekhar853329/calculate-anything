---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/layout/Navbar';
import Footer from '../../components/layout/Footer';
import ToolsDirectory from '../../components/tools/ToolsDirectory';
---

<BaseLayout
  title="All 110+ Free Online Calculators & Tools | CalculateAnything"
  description="Explore the complete collection of 110+ free calculators, converters, formatters, and utilities. Fast, responsive, and 100% private in your browser."
  canonical="/tools"
>
  <Navbar client:load />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 min-h-screen">
    <div className="mb-8">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs text-gray-500 dark:text-gray-400">
        <ol class="flex items-center gap-1.5">
          <li><a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-gray-800 dark:text-gray-200 font-semibold">All Tools</li>
        </ol>
      </nav>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-gray-100 tracking-tight mb-2">
        Browse All Tools
      </h1>
      <p class="text-base text-gray-600 dark:text-gray-400 max-w-3xl">
        Every calculator, converter, generator, and formatter in one fast directory. Filter by category or search below.
      </p>
    </div>

    <ToolsDirectory client:load />
  </main>

  <Footer client:load />
</BaseLayout>

