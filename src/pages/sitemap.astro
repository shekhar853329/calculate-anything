---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer';
import { CATEGORIES, getToolsByCategory } from '../data/tools';
import { ToolIcon, getCategoryTheme } from '../components/common/IconHelper';
import { FileCode, ArrowUpRight } from 'lucide-react';

const MAIN_PAGES = [
  { name: 'Home', href: '/', desc: 'Landing page with search, trending tools, and category browser' },
  { name: 'All Tools', href: '/tools', desc: 'Complete searchable directory of all 110+ calculators and utilities' },
  { name: 'About CalculateAnything', href: '/about', desc: 'Platform background, privacy principles, and vision' },
  { name: 'Contact Us', href: '/contact', desc: 'Feedback form, tool requests, and bug reports' },
  { name: 'Privacy Policy', href: '/privacy-policy', desc: 'Our strict client-side data privacy commitment' },
  { name: 'Terms of Service', href: '/terms', desc: 'Usage guidelines and terms of service' },
  { name: 'Disclaimer', href: '/disclaimer', desc: 'Educational and informational calculation disclaimers' },
];
---

<BaseLayout
  title="Sitemap - Full Directory of Free Tools | CalculateAnything"
  description="Explore the full sitemap of CalculateAnything. Access all 110+ calculators, converters, formatting tools, and category directories in one place."
  canonical="/sitemap"
>
  <Navbar client:load />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 min-h-screen">
    {/* Breadcrumbs */}
    <nav aria-label="Breadcrumb" class="mb-4 text-xs text-gray-500 dark:text-gray-400">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-gray-800 dark:text-gray-200 font-semibold">Sitemap</li>
      </ol>
    </nav>

    {/* Header */}
    <div class="mb-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-gray-200 dark:border-gray-800">
      <div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-gray-100 tracking-tight mb-2">
          Website Sitemap
        </h1>
        <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400 max-w-2xl">
          An indexed overview of all pages, categories, and 110+ browser-based utilities available on CalculateAnything.
        </p>
      </div>
      <a
        href="/sitemap.xml"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-xs font-semibold text-gray-700 dark:text-gray-300 hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors shrink-0 shadow-xs"
      >
        <FileCode class="w-4 h-4 text-blue-500" />
        <span>View XML Sitemap</span>
        <ArrowUpRight class="w-3.5 h-3.5 text-gray-400" />
      </a>
    </div>

    {/* Section 1: Main & Legal Pages */}
    <section class="mb-12">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span>
        Main & Legal Pages
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
        {MAIN_PAGES.map((page) => (
          <a
            href={page.href}
            class="group p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-850 hover:border-blue-400 dark:hover:border-blue-500 hover:shadow-sm transition-all"
          >
            <div class="flex items-center justify-between mb-1">
              <span class="font-bold text-sm text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {page.name}
              </span>
              <ArrowUpRight class="w-3.5 h-3.5 text-gray-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 shrink-0" />
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400">{page.desc}</p>
          </a>
        ))}
      </div>
    </section>

    {/* Section 2: Tools By Category */}
    <section class="space-y-10">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-indigo-600 inline-block"></span>
        Tools by Category
      </h2>

      {CATEGORIES.map((cat) => {
        const theme = getCategoryTheme(cat.slug);
        const tools = getToolsByCategory(cat.slug);

        return (
          <div class="p-6 rounded-2xl bg-white dark:bg-gray-850 border border-gray-200 dark:border-gray-800">
            <div class="flex items-center justify-between mb-5 flex-wrap gap-2">
              <div class="flex items-center gap-3">
                <div class={`w-10 h-10 rounded-xl flex items-center justify-center shrink-0 ${theme.bg} ${theme.text}`}>
                  <ToolIcon name={cat.icon} className="w-5 h-5" />
                </div>
                <div>
                  <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100">
                    <a href={`/category/${cat.slug}`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                      {cat.name}
                    </a>
                  </h3>
                  <p class="text-xs text-gray-500 dark:text-gray-400">
                    {tools.length} calculators & tools
                  </p>
                </div>
              </div>

              <a
                href={`/category/${cat.slug}`}
                class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline"
              >
                Browse category page &rarr;
              </a>
            </div>

            <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5">
              {tools.map((tool) => (
                <li>
                  <a
                    href={`/tools/${tool.slug}`}
                    class="group flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
                  >
                    <span class="text-xs text-gray-400 group-hover:text-blue-600 dark:group-hover:text-blue-400">•</span>
                    <span class="text-xs font-medium text-gray-700 dark:text-gray-300 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate">
                      {tool.name}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </section>
  </main>

  <Footer client:load />
</BaseLayout>

