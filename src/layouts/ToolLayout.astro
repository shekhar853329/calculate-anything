---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer';
import Breadcrumb from '../components/layout/Breadcrumb';
import ToolHeader from '../components/tool/ToolHeader';
import RelatedTools from '../components/tool/RelatedTools';
import FAQ from '../components/tool/FAQ';
import { getRelatedTools } from '../data/tools';
import { getSiteUrl } from '../utils/site';
import { buildToolSchema } from '../utils/schema';

const { tool } = Astro.props;
const related = getRelatedTools(tool.slug);
const origin = (Astro.site ? Astro.site.origin : getSiteUrl()).replace(/\/$/, '');

function getToolPageTitle(name: string): string {
  const full = `${name} - Free Online Tool | CalculateAnything`;
  if (full.length <= 60) return full;
  const alt = `${name} - Free Online | CalculateAnything`;
  if (alt.length <= 60) return alt;
  return `${name} | CalculateAnything`;
}

const pageTitle = getToolPageTitle(tool.name);
const schema = buildToolSchema(origin, tool, pageTitle);
---
<BaseLayout
  title={pageTitle}
  description={tool.description}
  canonical={`/tools/${tool.slug}/`}
  schema={schema}
>
  <Navbar client:load />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 pt-2.5 pb-10">
    <Breadcrumb
      category={tool.category}
      categorySlug={tool.categorySlug}
      toolName={tool.name}
      client:load
    />

    {/* Compact Header with Icon, Category, Title, Bookmark & Share */}
    <ToolHeader tool={tool} client:load />

    {/* Dedicated Elevated Tool Workspace */}
    <div class="bg-white dark:bg-gray-850 rounded-2xl border border-gray-200/90 dark:border-gray-800 shadow-sm p-4 sm:p-6 my-2.5">
      <slot />
    </div>

    <FAQ tool={tool} client:load />

    {related.length > 0 && <RelatedTools tools={related} client:load />}
  </main>

  <Footer client:load />
</BaseLayout>
