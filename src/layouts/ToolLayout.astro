---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer';
import Breadcrumb from '../components/layout/Breadcrumb';
import ToolHeader from '../components/tool/ToolHeader';
import RelatedTools from '../components/tool/RelatedTools';
import FAQ from '../components/tool/FAQ';
import { getRelatedTools } from '../data/tools';

const { tool } = Astro.props;
const related = getRelatedTools(tool.slug);
const origin = (Astro.site ? Astro.site.origin : Astro.url.origin).replace(/\/$/, '');

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.name,
  description: tool.description,
  url: `${origin}/tools/${tool.slug}`,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
});
---
<BaseLayout
  title={`${tool.name} - Free Online ${tool.name} | CalculateAnything`}
  description={tool.description}
  canonical={`/tools/${tool.slug}`}
>
  <script type="application/ld+json" set:html={schema} />
  <Navbar client:load />

  <main class="max-w-5xl mx-auto px-4 sm:px-6 pt-2.5 pb-10">
    <Breadcrumb
      category={tool.category}
      categorySlug={tool.categorySlug}
      toolName={tool.name}
      client:load
    />

    {/* Compact Header with Icon, Category, Title, Bookmark & Share */}
    <ToolHeader tool={tool} client:load />

    {/* Dedicated Elevated Tool Workspace */}
    <div class="bg-white dark:bg-gray-850 rounded-2xl border border-gray-200/90 dark:border-gray-800 shadow-sm p-4 sm:p-6 my-2.5">
      <slot />
    </div>

    {related.length > 0 && <RelatedTools tools={related} client:load />}

    <FAQ tool={tool} client:load />
  </main>

  <Footer client:load />
</BaseLayout>
